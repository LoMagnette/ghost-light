# Generated by npm run shoot. Screenshots are for reading back, not for keeping.
tools/shots/

# Competition reference material — Devoxx's files, not ours.
#
# Two reasons, and the first is the serious one. This repository is public and
# MIT licensed, so everything committed to it is being offered under that
# licence; the model sheets, floor plans and photographs are Devoxx Belgium's
# and are not ours to relicense. The second is that they are ~10 MB of PNG and
# CLAUDE.md says not to commit large binaries.
#
# They are still read directly off disk during development — see
# docs/ASSETS.md for the layout and where to download them.
references/

# Plan views regenerated by npm run venue -- --svg.
tools/plan-floor*.svg
